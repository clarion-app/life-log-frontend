{
  "name": "@clarion-app/life-log-frontend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "rm -rf dist; tsc"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/clarion-app/life-log-frontend.git"
  },
  "author": "Tim Schwartz <tim@metaverse.systems>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/clarion-app/life-log-frontend/issues"
  },
  "homepage": "https://github.com/clarion-app/life-log-frontend#readme",
  "dependencies": {
    "@clarion-app/contacts-frontend": "^1.1.0",
    "@clarion-app/frontend-base": "^1.0.0",
    "@clarion-app/types": "^2.0.0",
    "@reduxjs/toolkit": "^2.2.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.26.1",
    "typescript": "^5.5.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/react": "^18.3.3",
    "jsdom": "^29.0.1",
    "vitest": "^4.1.2"
  },
  "customFields": {
    "clarion": {
      "api": [
        "entryApi",
        "locationApi",
        "healthMetricApi",
        "serviceCredentialApi",
        "connectedAccountApi"
      ],
      "routes": [
        {
          "path": "/clarion-app/life-log",
          "element": "<Entries />"
        },
        {
          "path": "/clarion-app/life-log/:id",
          "element": "<Entry />"
        },
        {
          "path": "/clarion-app/life-log/health-metrics",
          "element": "<HealthMetrics />"
        },
        {
          "path": "/clarion-app/life-log/health-metrics/:id",
          "element": "<HealthMetric />"
        },
        {
          "path": "/clarion-app/life-log/locations",
          "element": "<Locations />"
        },
        {
          "path": "/clarion-app/life-log/locations/:id",
          "element": "<Location />"
        },
        {
          "path": "/clarion-app/life-log/wearable-services",
          "element": "<WearableServices />"
        },
        {
          "path": "/clarion-app/life-log/connected-services",
          "element": "<ConnectedServices />"
        },
        {
          "path": "/clarion-app/life-log/connected-services/callback/:service",
          "element": "<ConnectionCallback />"
        }
      ],
      "menu": {
        "name": "Life Log",
        "entries": [
          {
            "name": "Entries",
            "path": "/clarion-app/life-log"
          },
          {
            "name": "Health Metrics",
            "path": "/clarion-app/life-log/health-metrics"
          },
          {
            "name": "Locations",
            "path": "/clarion-app/life-log/locations"
          },
          {
            "name": "Wearable Services",
            "path": "/clarion-app/life-log/wearable-services"
          },
          {
            "name": "Connected Services",
            "path": "/clarion-app/life-log/connected-services"
          }
        ]
      }
    }
  }
}
